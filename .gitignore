# ==============================================================================
# SECURE-CENTRIC | WORDPRESS & CI/CD GITIGNORE
# ==============================================================================

# Local Environment and Secrets (Never commit credentials)
.env
.env.local
wp-config-local.php

# WordPress Uploads and Media (Media should live on S3 / CDN or persistent volume, not Git)
wp-content/uploads/
wp-content/blogs.dir/
wp-content/upgrade/
wp-content/backup-db/
wp-content/backups/

# Caches and Temporary Files
wp-content/cache/
wp-content/w3tc-config/
wp-content/advanced-cache.php
wp-content/wp-cache-config.php

# Logs and Debug
*.log
debug.log
wp-content/debug.log

# Database dumps
*.sql
*.sql.gz
*.tar.gz
*.zip

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node and Build artifacts (if adding build pipelines later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
